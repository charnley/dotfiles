function fast_edit()
{

    # if test -z "$1"; then

    # fi

    # Quickly go to folder and find the files you want to edit
    if command -v bat &> /dev/null
    then
        preview="bat --color always {}"
    else
        preview="cat {}"
    fi

    git branch &>/dev/null
    if test $? -eq 0
    then
        $EDITOR `git ls-files | fzf -m --preview="$preview"` $@
    else
        $EDITOR `fzf -m --preview="$preview"` $@
    fi
}

