alias gco='git commit'
alias gca='git commit -a'
gci() {
    local -a flags paths
    for arg in "$@"; do
        if test "${arg#-}" != "$arg"; then
            flags+=("$arg")
        else
            paths+=("$arg")
        fi
    done
    if test ${#paths[@]} -eq 0; then
        echo "requires path argument"
        return 1
    fi
    local tmpfile
    tmpfile=$(mktemp)
    echo "Generating commit message..." >&2
    git diff HEAD -- "${paths[@]}" | git-commit-msg > $tmpfile
    echo >> $tmpfile
    git commit --template="$tmpfile" "${flags[@]}" -- "${paths[@]}"
    rm "$tmpfile"
}
