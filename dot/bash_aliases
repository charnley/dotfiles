# git
function gitclone {

    url=$1
    out=$2

    if [[ $url != *"@"* && $url != *"http"* ]]
    then
        git clone git@github.com:$url $out
    else
        git clone $1 $out
    fi

}


fzf_log() {
    hash=$(git log --color=never --format="%h%d %an %ae %s %cr" "$@" | fzf -m | awk '{print $1}' | xargs)
    echo -n $hash | yank
    git show $(echo $hash | xargs)
}

